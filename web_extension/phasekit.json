{
  "workingDir": ".",
  "codeDir": "..",

  "plan": "PLAN.md",
  "prompts": "PROMPTS.md",
  "logDir": ".phasekit/logs",

  "model": "opus",
  "effort": "high",

  "branchPrefix": "plan/phase-",
  "requireCleanTree": true,
  "autoCompact": 150000,

  "usageLimit": {
    "maxRetries": 6,
    "waitMinutes": 20
  },

  "gates": [
    { "name": "tests", "cwd": ".", "run": "npm test" }
  ],

  "autoSequence": [
    { "target": "0.1", "note": "De-chunking cleanup: purge split/chunking from config" },
    { "target": "0.2", "note": "UI cleanup: remove split controls from popup" },
    { "target": "1.1", "note": "Manifest V3 Side Panel & Content Script declarations" },
    { "target": "1.2", "note": "YouTube Player seek bridge (content_youtube.js)" },
    { "target": "2.1", "note": "Universal single-pass streaming LLM client (llm-stream.js)" },
    { "target": "3.1", "note": "Streamlined Side Panel UI & modern CSS (sidepanel.html, sidepanel.css)" },
    { "target": "3.2", "note": "Side Panel controller: live streaming & timestamp seek (sidepanel.js)" },
    { "target": "4.1", "note": "Side Panel activation & background routing" },
    { "target": "4.2", "note": "Verification and gates green" }
  ]
}
