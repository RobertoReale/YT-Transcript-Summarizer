{
  "manifest_version": 3,
  "name": "YT Transcript Summarizer",
  "version": "10.22.1",
  "description": "Summarize YouTube videos with Claude, OpenAI, Gemini and more — reliable transcript extraction via InnerTube API.",
  "browser_specific_settings": {
    "gecko": {
      "id": "yt-transcript-summarizer@roberto-reale",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": [
          "websiteContent"
        ],
        "optional": []
      }
    }
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "tabs",
    "scripting",
    "downloads",
    "notifications",
    "alarms",
    "offscreen",
    "declarativeNetRequest",
    "sidePanel"
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "innertube_origin_fix",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://m.youtube.com/*",
    "https://music.youtube.com/*",
    "https://youtu.be/*",
    "https://api.anthropic.com/*",
    "https://claude.ai/*",
    "https://api.openai.com/*",
    "https://chatgpt.com/*",
    "https://generativelanguage.googleapis.com/*",
    "https://gemini.google.com/*",
    "https://openrouter.ai/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/watch*"
      ],
      "js": [
        "content_youtube.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://claude.ai/*"
      ],
      "js": [
        "paste_common.js",
        "claude_paste.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "paste_common.js",
        "chatgpt_paste.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://gemini.google.com/*"
      ],
      "js": [
        "paste_common.js",
        "gemini_paste.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "48": "logo.png",
    "128": "logo.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "YT Transcript Summarizer",
    "default_icon": "logo.png"
  },
  "background": {
    "service_worker": "background.js",
    "scripts": [
      "background.js"
    ],
    "type": "module"
  }
}
